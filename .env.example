# StudyPilot Environment Configuration
# Copy this file to .env.local and populate with your credentials

# App Configuration
NEXT_PUBLIC_APP_NAME="StudyPilot"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_MODE="true"

# Google Gemini AI API Key (Server-side privileged operations)
GEMINI_API_KEY=""

# Google Classroom & Drive OAuth 2.0 Credentials (Read-only access)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Firebase Client Configuration (Optional for production auth & firestore)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""

# Firebase Admin SDK (Server-side privileged)
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# Stripe Configuration (Test Mode for Pro Subscription $12/month)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
